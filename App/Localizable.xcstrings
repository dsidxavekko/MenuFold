    "Виберіть зображення (PNG, JPEG, HEIC, ICNS, SVG…) або програму, чий значок узяти.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Bild (PNG, JPEG, HEIC, ICNS, SVG…) oder eine App, deren Symbol verwendet werden soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an image (PNG, JPEG, HEIC, ICNS, SVG…) or an app whose icon to use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una imagen (PNG, JPEG, HEIC, ICNS, SVG…) o una app cuyo icono quieras usar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une image (PNG, JPEG, HEIC, ICNS, SVG…) ou une app dont l’icône sera utilisée."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz obraz (PNG, JPEG, HEIC, ICNS, SVG…) lub aplikację, której ikonę chcesz użyć."
          }
        }
      }
    },
