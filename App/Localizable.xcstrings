    },
    "Усі папки, власні й перевизначені категорії, власні значки та приховані програми буде видалено.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Ordner, eigenen und geänderten Kategorien, eigenen Symbole und ausgeblendeten Apps werden entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All folders, custom and overridden categories, custom icons and hidden apps will be removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todas las carpetas, categorías personalizadas y modificadas, iconos personalizados y apps ocultas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les dossiers, catégories personnalisées et modifiées, icônes personnalisées et apps masquées seront supprimés."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie foldery, własne i zmienione kategorie, własne ikony oraz ukryte aplikacje zostaną usunięte."
          }
        }
      }
    },
