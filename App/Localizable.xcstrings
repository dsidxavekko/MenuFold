    "Не вдалося прочитати розкладку («%@»). Файл не змінено — спробуйте перезапустити MenuFold.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Layout konnte nicht gelesen werden („%@“). Die Datei wurde nicht verändert – versuche, MenuFold neu zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the layout (“%@”). The file was not changed — try restarting MenuFold."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer la disposición (“%@”). El archivo no se ha modificado — prueba a reiniciar MenuFold."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la disposition (« %@ »). Le fichier n’a pas été modifié — essayez de relancer MenuFold."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać układu („%@”). Plik nie został zmieniony — spróbuj ponownie uruchomić MenuFold."
