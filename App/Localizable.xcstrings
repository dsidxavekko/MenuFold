      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ (%@)"
          }
        }
      }
    },
    "Виберіть зображення (PNG, JPEG, HEIC, ICNS, SVG…) або програму, чий значок узяти.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an image (PNG, JPEG, HEIC, ICNS, SVG…) or an app whose icon to use."
          }
        }
      }
    },
    "Вибрати": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose"
          }
        }
      }
    },
    "Вибрати інше…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Another…"
          }
        }
      }
    },
    "Видалити": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        }
      }
