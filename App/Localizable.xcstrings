    "Завершити примусово всі програми? Незбережені зміни буде втрачено." : {
      "comment" : "Confirmation before force-quitting every app on the Running tab.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Apps sofort beenden? Nicht gesicherte Änderungen gehen verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force quit all apps? Unsaved changes will be lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Forzar la salida de todas las apps? Se perderán los cambios no guardados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forcer à quitter toutes les apps ? Les modifications non enregistrées seront perdues."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymusić zakończenie wszystkich aplikacji? Niezapisane zmiany zostaną utracone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forzare l’uscita da tutte le app? Le modifiche non salvate andranno perse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forçar a saída de todos os apps? As alterações não salvas serão perdidas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのアプリを強制終了しますか?保存されていない変更は失われます。"
