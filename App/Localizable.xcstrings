    "Розкладка зберігається у файлі layout.json" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Layout wird in der Datei layout.json gesichert"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The layout is saved in layout.json"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disposición se guarda en el archivo layout.json"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disposition est enregistrée dans le fichier layout.json"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Układ jest zapisywany w pliku layout.json"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disposizione è salvata nel file layout.json"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O layout é salvo em layout.json"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レイアウトはlayout.jsonに保存されます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布局保存在 layout.json 文件中"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzen layout.json dosyasında saklanır"
          }
        }
      }
    },
    "Розкладка починається з чистої — папки, категорії та приховані програми доведеться налаштувати знову. Попередній файл не видалено: його можна вивчити або відновити вручну." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Layout beginnt neu – Ordner, Kategorien und ausgeblendete Apps müssen erneut eingerichtet werden. Die vorherige Datei wurde nicht gelöscht: Du kannst sie ansehen oder manuell wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The layout starts fresh — folders, categories and hidden apps have to be set up again. The previous file was not deleted: you can inspect it or restore it manually."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disposición empieza de cero — hay que volver a configurar las carpetas, las categorías y las apps ocultas. El archivo anterior no se ha eliminado: puedes revisarlo o restaurarlo manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disposition repart de zéro — les dossiers, catégories et apps masquées doivent être reconfigurés. L’ancien fichier n’a pas été supprimé : vous pouvez l’examiner ou le restaurer manuellement."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Układ zaczyna się od nowa — foldery, kategorie i ukryte aplikacje trzeba skonfigurować ponownie. Poprzedni plik nie został usunięty: można go przejrzeć lub ręcznie przywrócić."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disposizione riparte da zero: cartelle, categorie e app nascoste andranno configurate di nuovo. Il file precedente non è stato eliminato: puoi esaminarlo o ripristinarlo manualmente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O layout começa do zero — será preciso configurar de novo pastas, categorias e apps ocultos. O arquivo anterior não foi apagado: você pode examiná-lo ou restaurá-lo manualmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レイアウトは新しい状態から始まります。フォルダ、カテゴリ、非表示のアプリは再設定が必要です。以前のファイルは削除されていません。確認するか、手動で復元できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布局将从空白开始 — 文件夹、类别和已隐藏的 App 需要重新设置。之前的文件并未删除：你可以查看它或手动恢复。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzen sıfırdan başlar — klasörleri, kategorileri ve gizli uygulamaları yeniden ayarlamanız gerekir. Önceki dosya silinmedi: inceleyebilir veya elle geri yükleyebilirsiniz."
          }
        }
      }
    },
    "Розкладка пошкоджена" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layout beschädigt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layout Damaged"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disposición dañada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disposition endommagée"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Układ uszkodzony"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disposizione danneggiata"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layout Danificado"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レイアウトが破損しています"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布局已损坏"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzen Hasarlı"
          }
        }
      }
    },
    "Розкладку пошкоджено, але її не вдалося відкласти. Файл «%@» лишився на місці, збереження зупинено, щоб не втратити дані." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Layout ist beschädigt, konnte aber nicht beiseitegelegt werden. „%@“ wurde nicht verschoben und das Sichern ist angehalten, damit keine Daten verloren gehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The layout is damaged but couldn't be set aside. “%@” was left in place and saving is paused so no data is lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disposición está dañada, pero no se ha podido apartar. “%@” se ha dejado en su sitio y el guardado está en pausa para no perder datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disposition est endommagée mais n’a pas pu être mise de côté. « %@ » a été laissé en place et l’enregistrement est suspendu pour ne perdre aucune donnée."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Układ jest uszkodzony, ale nie udało się go odłożyć. Plik „%@” pozostał na miejscu, a zapisywanie wstrzymano, aby nie utracić danych."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disposizione è danneggiata ma non è stato possibile metterla da parte. “%@” è rimasto al suo posto e il salvataggio è sospeso per non perdere dati."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O layout está danificado, mas não foi possível separá-lo. “%@” foi mantido no lugar e o salvamento está pausado para não perder dados."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レイアウトが破損していますが、退避できませんでした。“%@”はそのまま残され、データを失わないよう保存を停止しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布局已损坏，但无法将其移开。文件“%@”保留在原处，并已暂停存储以免丢失数据。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzen hasarlı ama kenara alınamadı. “%@” yerinde bırakıldı ve veri kaybolmasın diye kaydetme duraklatıldı."
          }
        }
      }
    },
    "Розкладку пошкоджено, попередню копію збережено в «%@»." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Layout war beschädigt; die vorherige Kopie wurde als „%@“ gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The layout was damaged; the previous copy was saved as “%@”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disposición estaba dañada; la copia anterior se ha guardado como “%@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disposition était endommagée ; la copie précédente a été enregistrée sous « %@ »."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Układ był uszkodzony; poprzednią kopię zapisano jako „%@”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disposizione era danneggiata; la copia precedente è stata salvata come “%@”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O layout estava danificado; a cópia anterior foi salva como “%@”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レイアウトが破損していたため、以前のコピーを“%@”として保存しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布局已损坏；之前的副本已存储为“%@”。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzen hasarlıydı; önceki kopya “%@” olarak kaydedildi."
          }
        }
      }
    },
