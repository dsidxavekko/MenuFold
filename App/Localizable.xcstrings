            "value": "Quittez MenuFold, copiez le fichier manuellement et supprimez l’original."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończ MenuFold, skopiuj plik ręcznie i usuń oryginał."
          }
        }
      }
    },
    "Закріпити": {
      "localizations": {
