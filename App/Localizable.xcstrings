{
  "sourceLanguage" : "uk",
  "strings" : {
    "«%@» — це файл, а не тека. Виберіть іншу теку." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist eine Datei, kein Ordner. Wähle einen anderen Ordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is a file, not a folder. Choose another folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» es un archivo, no una carpeta. Elige otra carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est un fichier, pas un dossier. Choisissez un autre dossier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” to plik, a nie folder. Wybierz inny folder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” è un file, non una cartella. Scegli un’altra cartella."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” é um arquivo, não uma pasta. Escolha outra pasta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”はフォルダではなくファイルです。別のフォルダを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”是文件，不是文件夹。请选择其他文件夹。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” bir dosya, klasör değil. Başka bir klasör seçin."
          }
        }
      }
    },
