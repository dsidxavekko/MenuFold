    "Програма закріплюється через її контекстне меню: «Закріпити». Закріплені програми стоять рядом над сіткою на вкладці «Все»." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine App heftest du über ihr Kontextmenü an: „Anheften“. Angeheftete Apps stehen in einer Zeile über dem Raster im Tab „Alle“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pin an app from its context menu: “Pin”. Pinned apps sit in a row above the grid on the “All” tab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fija una app desde su menú contextual: “Fijar”. Las apps fijadas aparecen en una fila sobre la cuadrícula en la pestaña “Todas”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épinglez une app depuis son menu contextuel : « Épingler ». Les apps épinglées forment une rangée au-dessus de la grille dans l’onglet « Toutes »."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikację przypina się z jej menu kontekstowego: „Przypnij”. Przypięte aplikacje stoją w wierszu nad siatką na karcie „Wszystkie”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’app si fissa dal suo menu contestuale: “Fissa”. Le app fissate sono in una riga sopra la griglia nel riquadro “Tutte”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixe um app pelo menu de contexto dele: “Fixar”. Os apps fixados ficam em uma linha acima da grade na aba “Tudo”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリはコンテキストメニューの「固定」で固定できます。固定したアプリは「すべて」タブのグリッドの上に1列で表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可通过 App 的上下文菜单“固定”来固定它。已固定的 App 排成一行，显示在“全部”标签页的网格上方。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir uygulamayı bağlam menüsünden sabitleyin: “Sabitle”. Sabitlenen uygulamalar “Tümü” sekmesinde ızgaranın üstünde bir satırda durur."
          }
        }
      }
    },
