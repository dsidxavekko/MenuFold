    "Проведення двома пальцями вбік перемикає вкладки, щипок змінює розмір сітки." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swiping sideways with two fingers switches tabs; pinching changes the grid size."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit zwei Fingern seitlich wischen wechselt die Tabs; Zusammenziehen ändert die Rastergröße."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesunięcie dwoma palcami w bok przełącza karty, a szczypnięcie zmienia rozmiar siatki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayer latéralement avec deux doigts change d'onglet ; pincer modifie la taille de la grille."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslizar de lado con dos dedos cambia de pestaña; pellizcar cambia el tamaño de la cuadrícula."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorrere di lato con due dita cambia scheda; il pizzico cambia le dimensioni della griglia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslizar para o lado com dois dedos troca de aba; pinçar altera o tamanho da grade."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2本指で横にスワイプするとタブが切り替わり、ピンチでグリッドのサイズが変わります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双指横向轻扫可切换标签页，捏合可更改网格大小。"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki parmakla yana kaydırmak sekmeleri değiştirir; çimdikleme ızgara boyutunu değiştirir."
          }
        }
      }
    },
