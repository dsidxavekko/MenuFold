    "Власна категорія. Перетягніть, щоб змінити порядок; контекстне меню: перейменувати або видалити": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Kategorie. Zum Neuordnen ziehen; Kontextmenü: umbenennen oder löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom category. Drag to reorder; context menu: rename or delete"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Categoría personalizada. Arrastra para reordenar; menú contextual: renombrar o eliminar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Catégorie personnalisée. Faites glisser pour réorganiser ; menu contextuel : renommer ou supprimer"
          }
        },
        "pl": {
