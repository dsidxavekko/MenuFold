    "На малому екрані сітка автоматично зменшується, щоб панель вмістилась." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf einem kleinen Bildschirm wird das Raster automatisch verkleinert, damit das Panel passt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On a small screen the grid shrinks automatically so the panel fits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En una pantalla pequeña la cuadrícula se reduce automáticamente para que el panel quepa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur un petit écran, la grille se réduit automatiquement pour que le panneau tienne."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na małym ekranie siatka automatycznie się zmniejsza, aby panel się zmieścił."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su uno schermo piccolo la griglia si riduce automaticamente per far stare il pannello."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em uma tela pequena, a grade diminui automaticamente para o painel caber."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小さい画面では、パネルが収まるようにグリッドが自動的に縮小されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
