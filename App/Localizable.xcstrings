        }
      }
    },
    "Програму можна буде повернути з Кошика, поки його не очищено.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst die App aus dem Papierkorb zurücklegen, solange er nicht entleert wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can put the app back from the Trash until it is emptied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrás recuperar la app de la papelera mientras no se vacíe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez récupérer l’app dans la corbeille tant qu’elle n’est pas vidée."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikację można przywrócić z kosza, dopóki nie zostanie opróżniony."
          }
        }
      }
    },
    "Продуктивність": {
      "comment": "MenuFoldCore (looked up with L())",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
