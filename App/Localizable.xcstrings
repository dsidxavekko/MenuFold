    "Можна почати користуватися нею (наприклад, розкладкою з іншого Mac) або замінити її поточною.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst es verwenden (zum Beispiel ein Layout von einem anderen Mac) oder durch das aktuelle ersetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can start using it (for example, a layout from another Mac) or replace it with the current one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes empezar a usarla (por ejemplo, una disposición de otro Mac) o sustituirla por la actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez l’utiliser (par exemple une disposition d’un autre Mac) ou la remplacer par l’actuelle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Można zacząć z niego korzystać (na przykład z układu z innego Maca) lub zastąpić go bieżącym."
          }
        }
      }
    },
