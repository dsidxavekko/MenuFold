{
  "sourceLanguage": "uk",
  "strings": {
    "%@ — папка з Finder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — Finder folder"
          }
        }
      }
    },
    "%lld програм": {
      "comment": "Number of apps in a category",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld app"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld apps"
                }
              }
            }
          }
        },
        "uk": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld програми"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld програм"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld програма"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld програми"
                }
              }
            }
          }
        }
